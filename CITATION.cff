    given-names: "Sean"
    affiliation: "Arbor Engineering Group"
    email: sean@arboreng.com
repository-code: "https://github.com/arboreng/pq-migration-lab"
url: "https://arboreng.com/field-notes/pq-migration-lab"
license: MIT
date-released: "2026-08-05"
keywords:
  - post-quantum cryptography
  - crypto-agility
  - ml-kem
  - ml-dsa
  - tls
  - pki
  - scientific software
